{
  "extractor": {
    "facebook": {
      "directory": [
        "facebook",
        "uid_{user_id} upfbid_{user_pfbid} - {username}",
        "set:{set_id}"
      ],
      "filename": "uid_{user_id} upfbid_{user_pfbid} set_{set_id} id_{id} _{num}.{extension}",
      "loop": true
    },
    "instagram": {
      "filename": "ownerId_{owner_id} username_{username} postId_{post_id } postShortcode_{post_shortcode} _{num}.{extension}"
    },
    "twitter": {
      "filename": "authorId_{author[id]} tweetId_{tweet_id} rtweetId_{retweet_id} _{num}.{extension}"
    },
    "reddit": {
      "api": "oauth",
      "headers": {
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
      }
    }
  }
}